# TextBee SMS credentials - copy this file to ".env" and set your values.
# Never commit the real .env file to GitHub.
#
# TextBee sends through your own Android phone and SIM.
# Get your API key and Device ID from https://app.textbee.dev/dashboard
# (install the TextBee app on your phone and register the device first).
# TEXTBEE_DEVICE_ID is optional; leave it blank to use your default device.

TEXTBEE_API_KEY=your_api_key_here
TEXTBEE_DEVICE_ID=
